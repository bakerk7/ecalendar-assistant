    {
      "kind": "keyword",
      "pattern": "\\b(soccer|practice)\\b",
      "profiles": [
        "alex"
      ],
      "priority": 50,
      "note": "soccer -> Alex"
    },
    {
      "kind": "name",
      "pattern": "",
      "profiles": [],
      "priority": 80,
      "note": "profile names/aliases in the title"
    }
  ],
  "importer": {
    "feed_calendar_profile": "alex",
    "default_chore_profile": "dad",
    "color_overrides": {}
  },
  "app": {
    "server_url": "http://familycal.local:8091",
