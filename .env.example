# --- eCalendar session (pick one; the token is preferred) ---
# Current token from the eCalendar app (see SETUP.md / extract_ecal_config.py).
ECALENDAR_TOKEN=
# Optional: only used to re-login after the token is replaced (401). Re-login
# KICKS OUT every other session on the account, including the phone/Mac app.
ECAL_EMAIL=
ECAL_PASSWORD=

# --- account ids (same as ecal.py; see SETUP.md) ---
ECALENDAR_DEVICE=
ECALENDAR_TIMEZONE=America/Chicago
ECALENDAR_CATEGORIES={"family": "<CATEGORY_ID>"}

# --- gateway ---
# Shared secret clients send as the X-API-Key header. Empty = no auth (LAN only!).
GATEWAY_API_KEY=
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_CACHE_TTL=60
GATEWAY_RELOGIN_MIN_BACKOFF=60
GATEWAY_RELOGIN_MAX_BACKOFF=1800
LOG_LEVEL=INFO
